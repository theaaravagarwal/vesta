# Copy to ~/.config/vesta/host.env with mode 600 on the compute host.
# systemd EnvironmentFile syntax; this file contains no real credentials.
REQUIRE_GPU=1
LLAMACPP_BASE_URL=http://127.0.0.1:8078
LLAMACPP_MODEL=qwen2.5vl:3b
LIVE_RTSP_URL=
LIVE_RTSP_DISCOVER_USER=
LIVE_RTSP_DISCOVER_PASSWORD=
CAMERA_CONTEXT=
YOLO_CONFIG_DIR=/home/software/vesta/runtime/ultralytics
YOLO_FRAME_WORKERS=1
VIDEO_BATCH_SIZE=4
LLM_MAX_BATCH_REQUESTS=1

# ByteTrack dependencies are locked; do not install packages during requests.
YOLO_AUTOINSTALL=False
BEHAVIOR_YOLO_MODEL=/home/software/vesta/person-detect/yolo26s.pt
BEHAVIOR_VLM_MODEL=qwen2.5vl:3b

# Production keeps the existing event policy; observable-v3 failed development tests.
BEHAVIOR_EVENT_POLICY=baseline
BEHAVIOR_FOCUS_VIEW=0
BEHAVIOR_EVENT_MAX_TOKENS=1536
BEHAVIOR_EVENT_RETRY_MAX_TOKENS=3072
